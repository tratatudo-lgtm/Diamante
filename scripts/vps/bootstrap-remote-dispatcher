#!/usr/bin/env bash
set -Eeuo pipefail

TARGET="/usr/local/sbin/diamante-remote-diagnostics"
if [[ "${EUID}" -ne 0 ]]; then
  echo "Executar como root."
  exit 1
fi
command -v install >/dev/null 2>&1 || { echo "install não está disponível."; exit 2; }
command -v bash >/dev/null 2>&1 || { echo "bash não está disponível."; exit 2; }

TMP="$(mktemp /usr/local/sbin/diamante-remote-diagnostics.bootstrap.XXXXXX)"
cleanup() { rm -f "$TMP"; }
trap cleanup EXIT

cat > "$TMP" <<'DIAMANTE_DISPATCHER_EOF'
#!/usr/bin/env bash
set -euo pipefail

# Forced-command dispatcher for the dedicated GitHub Actions SSH key.
# SSH_ORIGINAL_COMMAND is compared literally and is never evaluated.
ACTION="${SSH_ORIGINAL_COMMAND:-}"
REBUILD_DIR="/opt/diamante-rebuild/Diamante"
INTEGRATION_DIR="/opt/diamante-rebuild/Diamante-integracao"

require_dir() {
  local dir="$1"
  if [[ ! -e "$dir/.git" ]]; then
    echo "Diretório Git não encontrado: $dir"
    exit 2
  fi
}

resolve_bun() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return 0
  fi
  local candidate
  for candidate in /root/.bun/bin/bun /usr/local/bin/bun /usr/bin/bun /bin/bun; do
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

case "$ACTION" in
  health)
    echo "===== HOST ====="
    hostname
    date -Is
    uptime
    echo
    echo "===== DISK ====="
    df -h /
    echo
    echo "===== MEMORY ====="
    free -h
    ;;
  services)
    echo "===== SYSTEMD ====="
    systemctl is-active diamante-api.service 2>/dev/null || true
    systemctl --no-pager --full status diamante-api.service 2>/dev/null | head -n 24 || true
    echo
    echo "===== PM2 ====="
    if command -v pm2 >/dev/null 2>&1; then pm2 list; else echo "PM2 não instalado para este utilizador."; fi
    echo
    echo "===== LISTENING PORTS ====="
    ss -lntp 2>/dev/null | head -n 35 || true
    ;;
  nginx)
    echo "===== NGINX STATUS ====="
    systemctl is-active nginx 2>/dev/null || true
    echo
    echo "===== NGINX CONFIG TEST ====="
    nginx -t 2>&1 || true
    echo
    echo "===== ENABLED SERVER BLOCKS ====="
    grep -RInE '^[[:space:]]*(listen|server_name|root|proxy_pass)[[:space:]]' /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null | head -n 100 || true
    ;;
  rebuild_git_status)
    echo "===== REBUILD REPOSITORY ====="
    require_dir "$REBUILD_DIR"
    git -C "$REBUILD_DIR" branch --show-current
    git -C "$REBUILD_DIR" log -1 --format='%h %s'
    git -C "$REBUILD_DIR" status --short --branch
    ;;
  integration_status)
    echo "===== INTEGRATION WORKTREE ====="
    require_dir "$INTEGRATION_DIR"
    git -C "$INTEGRATION_DIR" branch --show-current
    git -C "$INTEGRATION_DIR" log -1 --format='%h %s'
    git -C "$INTEGRATION_DIR" status --short --branch
    ;;
  integration_diff)
    echo "===== ADMIN FUNCIONARIOS LOCAL DIFF (READ ONLY) ====="
    require_dir "$INTEGRATION_DIR"
    git -C "$INTEGRATION_DIR" status --short -- src/components/admin/AdminFuncionariosPage.tsx
    echo
    echo "===== DIFF AGAINST WORKTREE HEAD ====="
    git -C "$INTEGRATION_DIR" --no-pager diff --no-ext-diff --no-color --unified=3 HEAD -- src/components/admin/AdminFuncionariosPage.tsx | sed -n '1,260p'
    echo
    echo "===== STAGED DIFF SUMMARY ====="
    git -C "$INTEGRATION_DIR" --no-pager diff --cached --stat -- src/components/admin/AdminFuncionariosPage.tsx
    ;;
  integration_bun_diagnostics)
    echo "===== BUN DIAGNOSTICS (READ ONLY) ====="
    id
    printf 'HOME=%s\n' "${HOME:-<unset>}"
    printf 'PATH=%s\n' "${PATH:-<unset>}"
    if BUN_BIN="$(resolve_bun)"; then
      printf 'BUN_PATH=%s\n' "$BUN_BIN"
      "$BUN_BIN" --version
    else
      echo "Bun não encontrado nos caminhos conhecidos."
      exit 3
    fi
    ;;
  integration_validate)
    echo "===== INTEGRATION VALIDATION ====="
    require_dir "$INTEGRATION_DIR"
    if ! BUN_BIN="$(resolve_bun)"; then
      echo "Bun não encontrado no PATH nem nos caminhos conhecidos."
      exit 3
    fi
    export PATH="$(dirname "$BUN_BIN"):$PATH"
    cd "$INTEGRATION_DIR"
    echo "===== SOURCE STATE ====="
    git branch --show-current
    git log -1 --format='%h %s'
    git status --short --branch
    echo
    echo "===== TYPESCRIPT CHECK (bun run lint) ====="
    LINT_STATUS=0
    if "$BUN_BIN" run lint; then echo "RESULTADO TYPESCRIPT: OK"; else LINT_STATUS=$?; echo "RESULTADO TYPESCRIPT: FALHOU ($LINT_STATUS)"; fi
    echo
    echo "===== BUILD (bun run build) ====="
    BUILD_STATUS=0
    if "$BUN_BIN" run build; then echo "RESULTADO BUILD: OK"; else BUILD_STATUS=$?; echo "RESULTADO BUILD: FALHOU ($BUILD_STATUS)"; fi
    echo
    echo "===== VALIDATION SUMMARY ====="
    echo "lint_exit_code=$LINT_STATUS"
    echo "build_exit_code=$BUILD_STATUS"
    if (( LINT_STATUS != 0 || BUILD_STATUS != 0 )); then exit 1; fi
    ;;
  *)
    echo "Operação não permitida."
    exit 64
    ;;
esac
DIAMANTE_DISPATCHER_EOF

echo "A validar dispatcher..."
bash -n "$TMP"
chmod 0755 "$TMP"

if [[ -e "$TARGET" ]]; then
  BACKUP="${TARGET}.backup-bootstrap-$(date +%Y%m%d-%H%M%S)"
  cp -a "$TARGET" "$BACKUP"
  echo "Backup criado: $BACKUP"
fi

install -o root -g root -m 0755 "$TMP" "$TARGET"
bash -n "$TARGET"
echo "Dispatcher instalado e validado."
sha256sum "$TARGET"
echo "Não foram alteradas chaves, configurações SSH ou serviços."
