#!/usr/bin/env bash
set -euo pipefail

# This script is installed as the SSH forced command for the dedicated
# GitHub Actions key. Never evaluate SSH_ORIGINAL_COMMAND as shell code.
ACTION="${SSH_ORIGINAL_COMMAND:-}"
REBUILD_DIR="/opt/diamante-rebuild/Diamante"
INTEGRATION_DIR="/opt/diamante-rebuild/Diamante-integracao"

require_dir() {
  local dir="$1"
  if [[ ! -e "$dir/.git" ]]; then
    echo "Diretório Git não encontrado: $dir"
    exit 2
  fi
}

case "$ACTION" in
  health)
    echo "===== HOST ====="
    hostname
    date -Is
    uptime
    echo
    echo "===== DISK ====="
    df -h /
    echo
    echo "===== MEMORY ====="
    free -h
    ;;
  services)
    echo "===== SYSTEMD ====="
    systemctl is-active diamante-api.service 2>/dev/null || true
    systemctl --no-pager --full status diamante-api.service 2>/dev/null | head -n 24 || true
    echo
    echo "===== PM2 ====="
    if command -v pm2 >/dev/null 2>&1; then
      pm2 list
    else
      echo "PM2 não instalado para este utilizador."
    fi
    echo
    echo "===== LISTENING PORTS ====="
    ss -lntp 2>/dev/null | head -n 35 || true
    ;;
  nginx)
    echo "===== NGINX STATUS ====="
    systemctl is-active nginx 2>/dev/null || true
    echo
    echo "===== NGINX CONFIG TEST ====="
    nginx -t 2>&1 || true
    echo
    echo "===== ENABLED SERVER BLOCKS ====="
    grep -RInE '^[[:space:]]*(listen|server_name|root|proxy_pass)[[:space:]]' \
      /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null | head -n 100 || true
    ;;
  rebuild_git_status)
    echo "===== REBUILD REPOSITORY ====="
    require_dir "$REBUILD_DIR"
    git -C "$REBUILD_DIR" branch --show-current
    git -C "$REBUILD_DIR" log -1 --format='%h %s'
    git -C "$REBUILD_DIR" status --short --branch
    ;;
  integration_status)
    echo "===== INTEGRATION WORKTREE ====="
    require_dir "$INTEGRATION_DIR"
    git -C "$INTEGRATION_DIR" branch --show-current
    git -C "$INTEGRATION_DIR" log -1 --format='%h %s'
    git -C "$INTEGRATION_DIR" status --short --branch
    ;;
  integration_validate)
    echo "===== INTEGRATION VALIDATION ====="
    require_dir "$INTEGRATION_DIR"
    if ! command -v bun >/dev/null 2>&1; then
      echo "Bun não está instalado ou não está no PATH."
      exit 3
    fi
    cd "$INTEGRATION_DIR"
    echo "===== SOURCE STATE ====="
    git branch --show-current
    git log -1 --format='%h %s'
    git status --short --branch
    echo
    echo "===== TYPESCRIPT CHECK (bun run lint) ====="
    LINT_STATUS=0
    if bun run lint; then
      echo "RESULTADO TYPESCRIPT: OK"
    else
      LINT_STATUS=$?
      echo "RESULTADO TYPESCRIPT: FALHOU ($LINT_STATUS)"
    fi
    echo
    echo "===== PRODUCTION BUILD (bun run build) ====="
    BUILD_STATUS=0
    if bun run build; then
      echo "RESULTADO BUILD: OK"
    else
      BUILD_STATUS=$?
      echo "RESULTADO BUILD: FALHOU ($BUILD_STATUS)"
    fi
    echo
    echo "===== VALIDATION SUMMARY ====="
    echo "lint_exit_code=$LINT_STATUS"
    echo "build_exit_code=$BUILD_STATUS"
    if (( LINT_STATUS != 0 || BUILD_STATUS != 0 )); then
      exit 1
    fi
    ;;
  *)
    echo "Operação não permitida."
    exit 64
    ;;
esac
