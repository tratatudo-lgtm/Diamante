# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase backend configuration. Never expose the service role key to the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="SUPABASE_SERVICE_ROLE_SECRET"

# Optional browser-side Supabase configuration; leave empty when using backend APIs only.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Groq (motor de IA exclusivo do backend; nunca usar prefixo VITE_)
GROQ_API_KEY=""

# Evolution API (WhatsApp Integration - Instância diamante-os)
# Em execução diretamente na VPS, a API Evolution existente está exposta na porta 9090.
EVOLUTION_API_URL="http://127.0.0.1:9090"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE="diamante-os"

# Segredos exclusivos do backend — nunca usar prefixo VITE_ nem expor no frontend
JWT_SECRET="GERAR_SEGREDO_ALEATORIO_FORTE_COM_PELO_MENOS_32_BYTES"
# Segredo HMAC independente do JWT; obrigatório para gerar hashes dos desafios OTP.
# Gerar um valor aleatório próprio com pelo menos 32 bytes. Nunca reutilizar o JWT_SECRET.
OTP_HMAC_SECRET="GERAR_SEGREDO_HMAC_ALEATORIO_COM_PELO_MENOS_32_BYTES"
PORT=3000
FRONTEND_URL="http://localhost:3000"

# Mensagens de aniversário: janela horária local de Portugal (Europe/Lisbon)
BIRTHDAY_WHATSAPP_SEND_FROM_HOUR="10"
BIRTHDAY_WHATSAPP_SEND_UNTIL_HOUR="20"
